{
  "project": {
    "name": "tomato-yield-impact",
    "seed": 42,
    "supported_classes": [
      "healthy",
      "early_blight",
      "late_blight",
      "bacterial_spot"
    ],
    "excluded_classes": [
      "leaf_mold"
    ]
  },
  "data": {
    "root": "artifacts/data",
