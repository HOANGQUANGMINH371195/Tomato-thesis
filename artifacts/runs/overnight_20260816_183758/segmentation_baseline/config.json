    "width_mult": 0.5,
    "num_classes": 4,
    "batch_size": 4,
    "effective_batch_size": 16,
    "epochs": 100,
    "optimizer": "adamw",
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "loss": "0.5_cross_entropy_plus_0.5_dice",
    "cross_entropy_weight": 0.5,
    "dice_weight": 0.5,
    "amp": true,
    "early_stopping_patience": 15
  },
  "yield_loss": {
